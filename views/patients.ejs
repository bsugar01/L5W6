<ul>
    <% patients.forEach(patient => { %>
      <li>
        <a href="/patient/<%= patient._id %>">
          <%= patient.name %> - <%= patient.illness %> - Room <%= patient.roomNumber %>
          <% if (patient.isolationRequired) { %>
            <strong style="color: red;">[Isolation]</strong>
          <% } %>
        </a>
      </li>
    <% }) %>
  </ul>
  