<!DOCTYPE html>
<html>
<head>
  <title>Add New Patient</title>
</head>
<body>
  <h1>Add New Patient</h1>
  <form action="/patient" method="POST">
    <label>Name:</label>
    <input type="text" name="name" required><br><br>

    <label>Age:</label>
    <input type="number" name="age" required><br><br>

    <label>Illness:</label>
    <input type="text" name="illness" required><br><br>

    <label>Room Number:</label>
    <input type="text" name="roomNumber" required><br><br>

    <label>Isolation Required:</label><br>
    <!-- ✅ Always sends a value: "false" if not checked, "true" if checked -->
    <input type="hidden" name="isolationRequired" value="false">
    <input type="checkbox" name="isolationRequired" value="true"> Yes<br><br>

    <button type="submit">Add Patient</button>
  </form>
  <br>
  <a href="/patients">Back to Patient List</a>
</body>
</html>
